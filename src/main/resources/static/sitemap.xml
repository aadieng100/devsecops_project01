<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!--
    Minimal sitemap so that ZAP's spider does not receive a 404 when
    probing /sitemap.xml, which would trigger a Non-Storable Content
    alert (ZAP rule 10049) on the error response.
  -->
  <url>
    <loc>/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/api/users</loc>
    <changefreq>always</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
